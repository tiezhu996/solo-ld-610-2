# Compose
COMPOSE_PROJECT_NAME=relic-restore

# 宿主机映射端口
FRONTEND_PORT=20110
BACKEND_PORT=21110
DB_PORT=54320

# PostgreSQL（db 服务；后端实际闭环持久化使用容器内 SQLite 命名卷 /data）
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password

# 后端
PORT=3000
JWT_SECRET=local-dev-secret
# 后端本地/SQLite 持久化文件（容器内）；宿主机直跑时默认 backend/data/relic-restore.db
DB_PATH=/data/relic-restore.db
SEED_ON_BOOT=true
